generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminSession {
  id        String    @id
  sessionId String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  AdminUser AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([sessionId])
}

model AdminUser {
  id           String         @id
  email        String         @unique
  name         String?
  password     String
  role         String         @default("admin")
  AdminSession AdminSession[]
}

model Album {
  id           String        @id
  slug         String        @unique
  name         String
  description  String?
  coverImageId String?
  isSystem     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  Image        Image?        @relation(fields: [coverImageId], references: [id])
  AlbumImage   AlbumImage[]
  CaseProject  CaseProject[]
}

model AlbumImage {
  id       String @id
  albumId  String
  imageId  String
  position Int    @default(0)
  Album    Album  @relation(fields: [albumId], references: [id])
  Image    Image  @relation(fields: [imageId], references: [id])

  @@unique([albumId, imageId])
}

model BlogPost {
  id          String    @id
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  publishedAt DateTime?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  content_en  String?
  content_zh  String?
  excerpt_en  String?
  excerpt_zh  String?
  isFeatured  Boolean   @default(false)
  seoDesc_en  String?
  seoDesc_zh  String?
  seoTitle_en String?
  seoTitle_zh String?
  title_en    String?
  title_zh    String?
  BlogTag     BlogTag[]
}

model BlogTag {
  blogPostId String
  tagId      String
  BlogPost   BlogPost @relation(fields: [blogPostId], references: [id])
  Tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([blogPostId, tagId])
}

model CaseProject {
  id          String   @id
  slug        String   @unique
  title_zh    String
  title_en    String?
  desc_zh     String?
  desc_en     String?
  client_zh   String?
  client_en   String?
  category_zh String?
  category_en String?
  year        Int?
  coverImage  String?
  images      String[]
  albumId     String?
  isPublished Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)
  seoTitle_zh String?
  seoTitle_en String?
  seoDesc_zh  String?
  seoDesc_en  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Album       Album?   @relation(fields: [albumId], references: [id])
}

model CategoryNode {
  id                 String         @id
  slug               String         @unique
  name_zh            String
  name_en            String
  description_zh     String?
  description_en     String?
  parentId           String?
  displayMode        String         @default("grid")
  order              Int            @default(0)
  coverImage         String?
  heroImage          String?
  icon               String?
  colorTheme         String?
  productIds         String[]
  seoTitle_zh        String?
  seoTitle_en        String?
  seoDescription_zh  String?
  seoDescription_en  String?
  isActive           Boolean        @default(true)
  isLeaf             Boolean        @default(false)
  isHidden           Boolean        @default(false)
  showInMenu         Boolean        @default(true)
  depth              Int            @default(0)
  path               String[]       @default([])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime
  tagIds             String[]
  parent             CategoryNode?  @relation("CategoryNodeToCategoryNode", fields: [parentId], references: [id], onDelete: Cascade)
  children           CategoryNode[] @relation("CategoryNodeToCategoryNode")

  @@index([depth])
  @@index([isActive])
  @@index([isHidden])
  @@index([order])
  @@index([parentId])
  @@index([slug])
}

model ContactInquiry {
  id          String        @id
  name        String
  email       String
  company     String?
  phone       String?
  inquiryType InquiryType   @default(GENERAL)
  productType String?
  quantity    String?
  timeline    String?
  budget      String?
  message     String
  status      InquiryStatus @default(NEW)
  notes       String?
  assignedTo  String?
  source      String        @default("website")
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  repliedAt   DateTime?
}

model FrontCategory {
  id                    String                  @id
  slug                  String                  @unique
  name                  String
  heroTitle             String?
  heroSubtitle          String?
  cardTitle             String?
  cardDescription       String?
  cardImage             String?
  baseCategory          Category?
  order                 Int                     @default(0)
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  heroImage             String?
  version               Int                     @default(1)
  FrontCategoryTagGroup FrontCategoryTagGroup[]
}

model FrontCategoryTagGroup {
  id              String        @id
  frontCategoryId String
  label           String
  description     String?
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  tagId           String
  FrontCategory   FrontCategory @relation(fields: [frontCategoryId], references: [id])
  Tag             Tag           @relation(fields: [tagId], references: [id])
}

model GiftSet {
  id          String        @id
  productId   String        @unique
  Product     Product       @relation(fields: [productId], references: [id])
  GiftSetItem GiftSetItem[]
}

model GiftSetItem {
  id        String  @id
  giftSetId String
  productId String
  quantity  Int     @default(1)
  GiftSet   GiftSet @relation(fields: [giftSetId], references: [id])
  Product   Product @relation(fields: [productId], references: [id])

  @@index([giftSetId])
  @@index([productId])
}

model HomeSection {
  id        Int             @id @default(autoincrement())
  type      HomeSectionType
  order     Int             @default(100)
  enabled   Boolean         @default(true)
  payload   Json
  createdAt DateTime        @default(now())
  updatedAt DateTime
}

model Image {
  id           String         @id
  url          String         @unique
  storageKey   String         @unique
  width        Int?
  height       Int?
  size         Int?
  mimeType     String?
  alt          String?
  title        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  isDeleted    Boolean        @default(false)
  Album        Album[]
  AlbumImage   AlbumImage[]
  ProductImage ProductImage[]
}

model ImageAsset {
  id        String   @id
  url       String
  label     String?
  createdAt DateTime @default(now())
}

model Page {
  id             String   @id
  slug           String   @unique
  title          String
  content        String
  heroImage      String?
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime
  createdAt      DateTime @default(now())
}

model Product {
  id                String         @id
  slug              String         @unique
  name              String
  category          Category
  shortDesc         String?
  description       String?
  sku               String?        @unique
  minQty            Int?
  priceHint         String?
  currency          String?
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  dimensions        String?
  leadTime          String?
  materials         String?
  notesForBuyer     String?
  originCountry     String?
  packagingInfo     String?
  status            ProductStatus  @default(ACTIVE)
  unit              String?
  coverImage        String?
  gallery           String[]
  version           Int            @default(1)
  description_en    String?
  description_zh    String?
  dimensions_en     String?
  dimensions_zh     String?
  images            String[]
  leadTime_en       String?
  leadTime_zh       String?
  materials_en      String?
  materials_zh      String?
  name_en           String?
  name_zh           String?
  notesForBuyer_en  String?
  notesForBuyer_zh  String?
  originCountry_en  String?
  originCountry_zh  String?
  packagingInfo_en  String?
  packagingInfo_zh  String?
  priceHint_en      String?
  priceHint_zh      String?
  seoDescription_en String?
  seoDescription_zh String?
  seoTitle_en       String?
  seoTitle_zh       String?
  shortDesc_en      String?
  shortDesc_zh      String?
  unit_en           String?
  unit_zh           String?
  enableAiGen       Boolean        @default(false)
  GiftSet           GiftSet?
  GiftSetItem       GiftSetItem[]
  ProductImage      ProductImage[]
  ProductTag        ProductTag[]
  AiUsageLog        AiUsageLog[]
}

model ProductImage {
  id        String  @id
  productId String
  imageId   String
  position  Int     @default(0)
  Image     Image   @relation(fields: [imageId], references: [id])
  Product   Product @relation(fields: [productId], references: [id])

  @@unique([productId, imageId])
}

model ProductTag {
  productId String
  tagId     String
  Product   Product @relation(fields: [productId], references: [id])
  Tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
}

model SitePage {
  id          String   @id
  slug        String   @unique
  type        PageType
  isDefault   Boolean  @default(false)
  isEnabled   Boolean  @default(false)
  showInNav   Boolean  @default(true)
  order       Int      @default(100)
  navLabel_zh String?
  navLabel_en String?
  label_zh    String?
  label_en    String?
  title_zh    String?
  title_en    String?
  desc_zh     String?
  desc_en     String?
  content_zh  String?
  content_en  String?
  seoTitle_zh String?
  seoTitle_en String?
  seoDesc_zh  String?
  seoDesc_en  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  pageData    Json?
}

model SiteSetting {
  id        String   @id @default("main")
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Tag {
  id                    String                  @id
  slug                  String                  @unique
  name                  String
  color                 String?
  subtitle              String?
  version               Int                     @default(1)
  name_en               String?
  name_zh               String?
  subtitle_en           String?
  subtitle_zh           String?
  BlogTag               BlogTag[]
  DimensionTagMapping   DimensionTagMapping[]
  FrontCategoryTagGroup FrontCategoryTagGroup[]
  ProductTag            ProductTag[]
}

model TrendReport {
  id         String            @id
  title      String
  prompt     String
  category   TrendCategory
  summary    String?
  insights   String?
  trendItems Json?
  status     TrendReportStatus @default(PENDING)
  error      String?
  sources    String[]          @default(["pinterest", "xiaohongshu"])
  createdAt  DateTime          @default(now())
  updatedAt  DateTime
}

model VirtualFolder {
  id        String   @id
  path      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model FilterDimension {
  id             String                @id @default(cuid())
  slug           String                @unique
  category       String
  name_zh        String
  name_en        String
  icon           String?
  order          Int                   @default(0)
  is_active      Boolean               @default(true)
  allow_multiple Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tagMappings    DimensionTagMapping[]

  @@index([category])
  @@index([is_active])
  @@index([order])
}

model DimensionTagMapping {
  id          String          @id @default(cuid())
  dimensionId String
  tagId       String
  order       Int             @default(0)
  dimension   FilterDimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  tag         Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([dimensionId, tagId])
  @@index([dimensionId])
  @@index([tagId])
}

// AI 生圖使用記錄
model AiUsageLog {
  id          String   @id @default(cuid())
  ipAddress   String
  productId   String?
  productSlug String?
  resultUrl   String?
  prompt      String?
  shareToken  String?  @unique
  createdAt   DateTime @default(now())
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([ipAddress])
  @@index([createdAt])
  @@index([shareToken])
}

// AI 提示詞範本
model AiPromptTemplate {
  id        String   @id @default(cuid())
  name_zh   String
  name_en   String
  prompt    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

// AI 詢價記錄（達到限制時收集 Email）
model AiInquiry {
  id         String   @id @default(cuid())
  email      String
  ipAddress  String
  productId  String?
  message    String?
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

enum Category {
  GIFT
  GIFT_BOX
  GIFT_SET
}

enum HomeSectionType {
  HERO
  WHY
  PRODUCTS
  FACTORY
  BLOG
  CTA
  RICH_TEXT
  GALLERY
  EMBED
  VIDEO
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  REPLIED
  QUOTED
  CONVERTED
  CLOSED
  SPAM
}

enum InquiryType {
  GENERAL
  QUOTE
  SAMPLE
  CUSTOM_DESIGN
  BULK_ORDER
  PARTNERSHIP
  COMPLAINT
  OTHER
  AI_DESIGN
}

enum PageType {
  HOMEPAGE
  PRODUCTS
  ABOUT
  FACTORY
  CONTACT
  CASE
  CUSTOM
  PROCESS
  FAQ
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TrendCategory {
  PACKAGING
  GIFT
  PRODUCT
}

enum TrendReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
