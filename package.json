{
  "name": "mb01",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node -e \"const fs=require('fs');const path=require('path');const cacheDir=path.join('.next','cache');if(fs.existsSync(cacheDir)){fs.rmSync(cacheDir,{recursive:true,force:true});console.log('Removed .next/cache')}\"",
    "start": "next start",
    "lint": "next lint",
    "seed": "ts-node prisma/seed.ts",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && wrangler pages dev",
    "deploy": "npm run pages:build && wrangler pages deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.934.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "next": "14.2.5",
    "prisma": "^6.19.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "20.11.19",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.17",
    "autoprefixer": "^10.4.22",
    "eslint": "8.56.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3",
    "vercel": "^37.14.0",
    "wrangler": "^3.114.15"
  }
}
