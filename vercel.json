{
  "buildCommand": "prisma generate && next build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "functions": {
    "app/api/admin/images/route.ts": {
      "maxDuration": 30
    },
    "app/api/admin/research/**/*.ts": {
      "maxDuration": 180
    },
    "app/api/cron/research/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/research",
      "schedule": "0 6 * * 1,3,5"
    }
  ]
}
